+    void emit_preview() {
+        mtmd::gen_state_ptr preview(mtmd_gen_state_init(mctx, mtmd_gen_state_params_default()));
+        if (!preview) {
+            return;
+        }
+        mtmd_gen_inp inp = mtmd_gen_inp_default(mctx);
+        inp.type = MTMD_GEN_PROCESS_TYPE_GEN_WAV;
