+        inp.n_codes = codes_buf.size();
+        mtmd_gen_out out{};
+        if (mtmd_gen_audio_process(mctx, preview.get(), &inp, &out) != 0 ||
+                out.n_samples <= 0 || !std::any_of(out.audio, out.audio + out.n_samples,
+                    [](float sample) { return std::fabs(sample) >= 0.005f; })) {
+            return;
+        }
+        audio_pcm.insert(audio_pcm.end(), out.audio, out.audio + out.n_samples);
+        preview_samples = out.n_samples;
