diff --git a/dist/zod4-compat.js b/dist/zod4-compat.js
new file mode 100644
index 0000000000000000000000000000000000000000..e670a0455d489c215ab68e9d37b7a1ee63f9b428
--- /dev/null
+++ b/dist/zod4-compat.js
@@ -0,0 +1,15 @@
+import { z } from "zod";
+
+// The legacy configuration schemas use objects, arrays and optional/nullable fields.
+// Unions remain unchanged, matching the original deepPartial behavior.
+export function partialConfig(schema) {
+  if (schema instanceof z.ZodObject) {
+    return schema.extend(Object.fromEntries(Object.entries(schema.shape).map(
+      ([key, value]) => [key, partialConfig(value).optional()]
+    )));
+  }
+  if (schema instanceof z.ZodArray) return z.array(partialConfig(schema.element));
+  if (schema instanceof z.ZodOptional) return partialConfig(schema.unwrap()).optional();
+  if (schema instanceof z.ZodNullable) return partialConfig(schema.unwrap()).nullable();
+  return schema;
+}
