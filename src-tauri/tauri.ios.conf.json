{
  "identifier": "com.rey30.idvj.app.ios",
  "build": {
    "devUrl": null,
    "frontendDist": "../web-app/dist",
    "beforeDevCommand": "cross-env IS_DEV=true IS_IOS=true yarn build:web",
    "beforeBuildCommand": "cross-env IS_IOS=true yarn build:web"
  },
  "app": {
    "security": {
      "capabilities": [
        "mobile"
      ]
    }
  },
  "plugins": {},
  "bundle": {
    "active": true,
    "iOS": {
      "developmentTeam": "<DEVELOPMENT_TEAM_ID>"
    },
    "resources": [
      "resources/LICENSE",
      "resources/NOTICE",
      "resources/LICENSE-APACHE-2.0.txt"
    ],
    "externalBin": []
  }
}
