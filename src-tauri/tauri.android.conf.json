{
  "identifier": "com.rey30.idvj.app",
  "build": {
    "devUrl": null,
    "frontendDist": "../web-app/dist",
    "beforeDevCommand": "cross-env IS_DEV=true IS_ANDROID=true yarn build:web",
    "beforeBuildCommand": "cross-env IS_ANDROID=true yarn build:web"
  },
  "app": {
    "security": {
      "capabilities": [
        "mobile"
      ]
    }
  },
  "plugins": {},
  "bundle": {
    "active": true,
    "resources": [
      "resources/LICENSE",
      "resources/NOTICE",
      "resources/LICENSE-APACHE-2.0.txt"
    ],
    "externalBin": [],
    "android": {
      "minSdkVersion": 24
    }
  }
}
