{
  "name": "@rey30-idvj/core",
  "version": "0.1.10",
  "description": "Core library for the Rey30 IDvj AI application framework",
  "keywords": [
    "rey30-idvj",
    "core"
  ],
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "typings": "dist/types/index.d.ts",
  "files": [
    "dist",
    "types"
  ],
  "author": "Reinier Tamayo (Rey30 IDvj distribution)",
  "scripts": {
    "lint": "tslint --project tsconfig.json -t codeFrame 'src/**/*.ts' 'test/**/*.ts'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "prebuild": "rimraf dist",
    "build": "tsc -p . && rolldown -c rolldown.config.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "19.1.2",
    "@vitest/coverage-v8": "^3.2.7",
    "@vitest/ui": "^3.2.7",
    "eslint": "8.57.0",
    "happy-dom": "^21.0.4",
    "react": "19.0.0",
    "rimraf": "^6.0.1",
    "rolldown": "1.2.16",
    "tslib": "^2.6.2",
    "typescript": "^5.8.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "rxjs": "^7.8.1",
    "ulidx": "^2.3.0"
  },
  "peerDependencies": {
    "react": "19.0.0"
  },
  "packageManager": "yarn@4.5.3"
}
