{
  "name": "@rey30-idvj/vector-db-extension",
  "productName": "Vector DB",
  "version": "0.1.0",
  "description": "Vector DB integration using sqlite-vec if available with linear fallback",
  "main": "dist/index.js",
  "module": "dist/module.js",
  "author": "Reinier Tamayo (Rey30 IDvj distribution)",
  "license": "Apache-2.0",
  "scripts": {
    "build": "rolldown -c rolldown.config.mjs",
    "build:publish": "rimraf *.tgz --glob || true && yarn build && npm pack && node ../../scripts/copy-files.mjs archives",
    "test": "vitest run"
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "rimraf": "6.0.1",
    "rolldown": "1.2.16",
    "typescript": "5.9.2",
    "vitest": "3.2.7"
  },
  "dependencies": {
    "@rey30-idvj/core": "workspace:*",
    "@rey30-idvj/tauri-plugin-rag-api": "link:../../src-tauri/plugins/tauri-plugin-rag",
    "@rey30-idvj/tauri-plugin-vector-db-api": "link:../../src-tauri/plugins/tauri-plugin-vector-db"
  },
  "files": [
    "dist/*",
    "package.json"
  ],
  "installConfig": {
    "hoistingLimits": "workspaces"
  },
  "packageManager": "yarn@4.5.3"
}
