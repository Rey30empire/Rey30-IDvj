{
  "name": "@rey30-idvj/mlx-extension",
  "productName": "MLX Inference Engine",
  "version": "1.0.0",
  "description": "This extension enables MLX-Swift inference on Apple Silicon Macs",
  "main": "dist/index.js",
  "module": "dist/module.js",
  "engine": "mlx",
  "author": "Reinier Tamayo (Rey30 IDvj distribution)",
  "license": "Apache-2.0",
  "scripts": {
    "build": "rolldown -c rolldown.config.mjs",
    "build:publish": "rimraf *.tgz --glob || true && yarn build && npm pack && node ../../scripts/copy-files.mjs archives",
    "test": "vitest run"
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "rimraf": "3.0.2",
    "rolldown": "1.2.16",
    "typescript": "5.9.2",
    "vitest": "3.2.7"
  },
  "dependencies": {
    "@rey30-idvj/core": "workspace:*",
    "@rey30-idvj/tauri-plugin-llamacpp-api": "link:../../src-tauri/plugins/tauri-plugin-llamacpp",
    "@rey30-idvj/tauri-plugin-mlx-api": "link:../../src-tauri/plugins/tauri-plugin-mlx",
    "@tauri-apps/api": "2.8.0",
    "@tauri-apps/plugin-http": "2.5.9"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist/*",
    "package.json"
  ],
  "installConfig": {
    "hoistingLimits": "workspaces"
  },
  "packageManager": "yarn@4.5.3"
}
